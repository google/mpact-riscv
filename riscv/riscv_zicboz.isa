// This file defines the cache block zero instruction in the Zicboz extension.
//
// The cache block size zeroed by `cbo.zero` is implementation-specific. It is
// bound to the semantic function here as 64 bytes, the common cache line size
// across RISC-V profiles. ISAs for implementations with a different cache block
// size can override `cbo_zero` and bind their own size.

slot riscv_zicboz32 {
  includes {
    #include "absl/functional/bind_front.h"
    #include "riscv/riscv_zicboz_instructions.h"
  }
  default size = 4;
  opcodes {
    cbo_zero{: rs1 :},
      resources: { rs1 :},
      disasm: "cbo.zero", "0(%rs1)",
      semfunc: "absl::bind_front(&RV32::RiscVCboZero, /*cache_block_size=*/64)";
  }
}

slot riscv_zicboz64 : riscv_zicboz32 {
  includes {
    #include "absl/functional/bind_front.h"
    #include "riscv/riscv_zicboz_instructions.h"
  }
  default size = 4;
  opcodes {
    cbo_zero = override,
      semfunc: "absl::bind_front(&RV64::RiscVCboZero, /*cache_block_size=*/64)";
  }
}
